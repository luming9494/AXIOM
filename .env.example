# 默认使用 DeepSeek 官方 API，按量计费。密钥仅保存在本地 .env，禁止提交。
AXIOM_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 每次模型请求的超时，5–180秒；仍受任务总墙钟预算限制。
AXIOM_MODEL_TIMEOUT_SECONDS=120

# 可选 NVIDIA NIM：只有显式设置 AXIOM_MODEL_PROVIDER=nvidia-nim 才会尝试。
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4.1-flash

# 仅在选择 NIM 时生效：明确额度耗尽后，使用上面的官方 Key 作为付费备用。
# 默认选择官方时不会先尝试 NIM，也不会因官方出错而切回 NIM。
AXIOM_DEEPSEEK_FALLBACK=true
# 设 false 可禁用 NIM → 官方自动回退。临时限流/超时/认证失败不触发付费回退。
