{
  "name": "axiom-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "test:web": "playwright test --config apps/web/playwright.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ml": "python -m unittest discover -s tests/python -v",
    "axiom": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
